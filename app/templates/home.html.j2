{% extends "base.html.j2" %}
{% block head %}
<title>CrysoK</title>
<meta name="description" content="{{ _('Main website page with information about me') }}" />
<link rel="stylesheet" href="{{ url_for('static', filename='css/home.css') }}" />
{% endblock head %}
{% block main %}
{% if page %}
<div class="home-header">
  <div class="pic overlay">
    <img src="{{ page.cover_image }}" alt="" />
  </div>
  <div>
    <h1>{{ page.title[g.lang] }}</h1>
    {% for subtitle in page.meta.get('subtitles_' ~ g.lang, []) %}
    <p>{{ subtitle }}</p>
    {% endfor %}
  </div>
</div>
<div class="home-content max-width-550px">
  {{ rendered_body[g.lang] | safe }}
</div>
<div class="home-buttons max-width-550px">
  <a class="button-1" href="{{ url_for('links') }}">{{ _('Contact me') }}</a>
  {% if page.meta.get('cv_url_' ~ g.lang) %}
  <a class="button-1" href="{{ page.meta.get('cv_url_' ~ g.lang) }}"
    download>{{ _('CV') }}</a>
  {% endif %}
</div>
{% else %}
<div class="home-content max-width-550px" style="text-align: center; padding: 2rem 0;">
  <h2>{{ _('Content Unavailable') }}</h2>
  <p>{{ _('The content for this page could not be loaded at this time. Please try again later.') }}</p>
</div>
{% endif %}
<p class="max-width-550px" style="width: 100%; text-align: center;">
  <img id="activity"
    data-idle-message="{{ _('No activity for now...') }}"
    style="border: 2px solid var(--color-accent2); border-radius: 6px; max-width: 100%; height: auto;"
    title="{{ _('Activity provided by Discord, via lanyard-profile-readme') }}"
    alt="{{ _('Activity provided by Discord, via lanyard-profile-readme') }}">
</p>

<script>
  (function () {
    const img = document.querySelector("#activity");
    if (!img) return;

    const idleMessage = img.dataset.idleMessage;
    let timer = null;

    function activity() {
      const api = "https://lanyard.cnrad.dev/api/";
      const id = "469204451777839155";
      const bg = getComputedStyle(document.documentElement).getPropertyValue("--color-bg1");
      const params = new URLSearchParams({
        theme: "dark",
        bg,
        borderRadius: "0",
        idleMessage,
        showDisplayName: "true",
        t: Date.now().toString(),
      });
      img.src = `${api}${id}?${params}`;
    }

    function start() {
      activity();
      if (timer == null) {
        timer = setInterval(activity, 10000);
      }
    }

    function stop() {
      if (timer != null) {
        clearInterval(timer);
        timer = null;
      }
    }

    document.addEventListener("visibilitychange", function () {
      if (document.hidden) stop();
      else start();
    });

    if (!document.hidden) start();
  })();
</script>
{% endblock main %}
