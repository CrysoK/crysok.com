{% extends "base.html.j2" %}
{% block head %}
<title>CrysoK</title>
<meta name="description" content="{{ _('Main website page with information about me') }}" />
<link rel="stylesheet" href="{{ url_for('static', filename='css/home.css') }}" />
{% endblock head %}
{% block main %}
{% if page %}
<div class="home-header">
  <div class="pic overlay">
    <img src="{{ page.cover_image }}" alt="" />
  </div>
  <div>
    <h1>{{ page.title[g.lang] }}</h1>
    {% for subtitle in page.meta.get('subtitles_' ~ g.lang, []) %}
    <p>{{ subtitle }}</p>
    {% endfor %}
  </div>
</div>
<div class="home-content max-width-550px">
  {{ page.body_html[g.lang] | safe }}
</div>
<div class="home-buttons max-width-550px">
  <a class="button-1" href="{{ url_for('links') }}">{{ _('Contact me') }}</a>
  {% if page.meta.get('cv_url_' ~ g.lang) %}
  <a class="button-1" href="{{ page.meta.get('cv_url_' ~ g.lang) }}"
    download>{{ _('CV') }}</a>
  {% endif %}
</div>
{% else %}
<div class="home-content max-width-550px" style="text-align: center; padding: 2rem 0;">
  <h2>{{ _('Content Unavailable') }}</h2>
  <p>{{ _('The content for this page could not be loaded at this time. Please try again later.') }}</p>
</div>
{% endif %}
<p class="max-width-550px" style="width: 100%; text-align: center;">
  <img id="activity" style="border: 2px solid var(--color-accent2); border-radius: 6px; max-width: 100%; height: auto;"
    title="{{ _('Activity provided by Discord, via lanyard-profile-readme') }}"
    alt="{{ _('Activity provided by Discord, via lanyard-profile-readme') }}">
</p>

<script>
  function activity() {
    let api = "https://lanyard.cnrad.dev/api/"
    let id = "469204451777839155"
    let theme = "dark"
    let bg = getComputedStyle(document.documentElement).getPropertyValue('--color-bg1')
    let borderRadius = "0"
    let idleMessage = "{{ _('No activity for now...') }}"
    let showDisplayName = "true"
    let hideProfile = "true"

    let params = new URLSearchParams({
      theme,
      bg,
      borderRadius,
      idleMessage,
      showDisplayName,
      // hideProfile,
      "t": new Date().getTime()
    }).toString()

    document.querySelector('#activity').src = `${api}${id}?${params}`
  }
  activity()
  setInterval(activity, 10000) // 10 seconds
</script>
{% endblock main %}
